---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'GEMCA — Education & Migration Consultants Australia',
  description = 'MARA Registered Migration Agents in Truganina, VIC. Expert guidance for skilled migration, student visas, partner visas, employer sponsorship and more. Confidential, professional, end-to-end.',
  ogImage = '/og-image.png',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0B2A6B" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.gemca.com.au" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://www.gemca.com.au" />
  <meta property="og:image" content={`https://www.gemca.com.au${ogImage}`} />
  <meta property="og:locale" content="en_AU" />
  <meta property="og:site_name" content="GEMCA" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`https://www.gemca.com.au${ogImage}`} />

  <!-- Preconnect for fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Archivo:wght@300;400;500&display=swap" rel="stylesheet" />

  <!-- Favicon inline SVG -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["LegalService", "LocalBusiness"],
      "name": "GEMCA — Education & Migration Consultants Australia",
      "legalName": "Goraya Education & Migration Consultant Australia Pty Ltd",
      "alternateName": "GEMCA",
      "description": "MARA Registered Migration Agents providing skilled migration, student visas, partner visas, employer sponsorship and education consultancy services in Australia.",
      "url": "https://www.gemca.com.au",
      "telephone": ["+61413769458", "+61370203358"],
      "email": "ansar@gemca.com.au",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "8 Tallis Circuit",
        "addressLocality": "Truganina",
        "addressRegion": "VIC",
        "postalCode": "3029",
        "addressCountry": "AU"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -37.8427,
        "longitude": 144.7408
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "17:30"
        }
      ],
      "priceRange": "$$",
      "image": "https://www.gemca.com.au/og-image.png",
      "areaServed": "AU",
      "knowsLanguage": ["en"],
      "hasCredential": "MARA Registered Migration Agent"
    }
  </script>

  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
