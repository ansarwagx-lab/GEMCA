---
---
<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-hidden bg-royal-deep"
  aria-label="Hero"
>
  <!-- Background gradient mesh -->
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-br from-royal-deep via-royal to-royal-light/40"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 20% 50%, rgba(46,91,199,0.25) 0, transparent 60%), radial-gradient(ellipse at 80% 20%, rgba(199,166,99,0.08) 0, transparent 40%), radial-gradient(ellipse at 60% 90%, rgba(5,20,58,0.6) 0, transparent 50%)"></div>
    <!-- Fine grid lines -->
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(rgba(201,208,219,1) 1px, transparent 1px), linear-gradient(90deg, rgba(201,208,219,1) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <!-- Floating Meridian symbol -->
  <div
    id="hero-symbol"
    class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/4 lg:translate-x-0 lg:right-[4%] opacity-20 lg:opacity-30 pointer-events-none select-none"
    aria-hidden="true"
  >
    <svg class="w-[280px] h-[280px] lg:w-[480px] lg:h-[480px] xl:w-[560px] xl:h-[560px] animate-drift" style="filter: drop-shadow(0 0 60px rgba(46,91,199,0.4));">
      <use href="#mark-glass"/>
    </svg>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 pt-32 pb-24 lg:pt-40 lg:pb-32 w-full">
    <div class="max-w-2xl xl:max-w-3xl">

      <!-- Pre-heading -->
      <div class="reveal flex items-center gap-3 mb-6">
        <span class="gold-hairline-h w-10"></span>
        <span class="font-body text-gold text-xs tracking-[0.18em] uppercase">MARA Registered Migration Agents</span>
      </div>

      <!-- Main headline -->
      <h1 class="reveal font-display font-medium text-paper leading-[1.08] tracking-tight mb-6" style="transition-delay:0.1s">
        <span class="block text-4xl sm:text-5xl lg:text-6xl xl:text-7xl">Your Trusted</span>
        <span class="block text-4xl sm:text-5xl lg:text-6xl xl:text-7xl">Australian Education</span>
        <span class="block text-4xl sm:text-5xl lg:text-6xl xl:text-7xl">&amp; Migration <em class="not-italic text-gold-light">Partner.</em></span>
      </h1>

      <!-- Supporting copy -->
      <p class="reveal font-body text-platinum text-base lg:text-lg leading-relaxed mb-10 max-w-xl" style="transition-delay:0.2s">
        Professional, confidential migration consultancy from a MARA registered agent. We guide skilled workers, families, students, and employers through every step of the Australian visa process — subject to eligibility and Department of Home Affairs requirements.
      </p>

      <!-- CTAs -->
      <div class="reveal flex flex-col sm:flex-row gap-4 mb-12" style="transition-delay:0.3s">
        <a
          href="#contact"
          class="btn-magnetic inline-flex items-center justify-center gap-2 bg-royal-light hover:bg-royal border border-royal-light/50 hover:border-gold/40 text-paper font-body font-medium text-sm px-7 py-3.5 rounded-sm tracking-wide transition-all duration-300 shadow-glass-lg"
        >
          Book a Consultation
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a
          href="#services"
          class="btn-magnetic inline-flex items-center justify-center gap-2 border border-platinum/25 hover:border-platinum/50 text-platinum hover:text-paper font-body text-sm px-7 py-3.5 rounded-sm tracking-wide transition-all duration-300"
        >
          Explore Services
        </a>
      </div>

      <!-- Trust badges -->
      <div class="reveal flex flex-wrap items-center gap-x-6 gap-y-3" style="transition-delay:0.4s">
        <span class="flex items-center gap-2 font-body text-xs text-platinum-dp tracking-wide">
          <svg class="w-4 h-4 text-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          🇦🇺 MARA Registered
        </span>
        <span class="w-px h-3 bg-platinum/20 hidden sm:block" aria-hidden="true"></span>
        <span class="flex items-center gap-2 font-body text-xs text-platinum-dp tracking-wide">
          <svg class="w-4 h-4 text-platinum-dp flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Truganina VIC
        </span>
        <span class="w-px h-3 bg-platinum/20 hidden sm:block" aria-hidden="true"></span>
        <span class="font-body text-xs text-platinum-dp tracking-wide">Confidential &amp; Professional</span>
      </div>
    </div>
  </div>

  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-paper/10 to-transparent pointer-events-none" aria-hidden="true"></div>
</section>

<script>
  // Hero symbol parallax + mouse tilt
  const sym = document.getElementById('hero-symbol');
  if (sym && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf: number;
    let tx = 0, ty = 0, rx = 0, ry = 0;

    // Scroll parallax
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      ty = y * -0.2;
      sym.style.transform = `translateY(calc(-50% + ${ty}px))`;
    }, { passive: true });

    // Mouse tilt (desktop only)
    if (window.innerWidth >= 1024) {
      document.addEventListener('mousemove', (e) => {
        const cx = window.innerWidth / 2;
        const cy = window.innerHeight / 2;
        rx = ((e.clientY - cy) / cy) * 6;
        ry = ((e.clientX - cx) / cx) * -6;

        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          (sym.querySelector('svg') as SVGElement).style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
          (sym.querySelector('svg') as SVGElement).style.transformOrigin = 'center';
        });
      });
    }
  }

  // Magnetic button effect
  document.querySelectorAll('.btn-magnetic').forEach(btn => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const el = btn as HTMLElement;
    el.addEventListener('mousemove', (e: Event) => {
      const me = e as MouseEvent;
      const rect = el.getBoundingClientRect();
      const x = (me.clientX - rect.left - rect.width / 2) * 0.25;
      const y = (me.clientY - rect.top - rect.height / 2) * 0.25;
      el.style.transform = `translate(${x}px, ${y}px)`;
    });
    el.addEventListener('mouseleave', () => {
      el.style.transform = '';
    });
  });
</script>
