---
---
<section id="contact" class="py-24 lg:py-32 bg-paper" aria-labelledby="contact-heading">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Section header -->
    <div class="reveal text-center mb-16">
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="gold-hairline-h w-10"></span>
        <span class="font-body text-gold text-xs tracking-[0.18em] uppercase">Get in Touch</span>
        <span class="gold-hairline-h w-10"></span>
      </div>
      <h2 id="contact-heading" class="font-display font-medium text-royal-deep text-3xl lg:text-5xl tracking-tight mb-4">
        Start Your Consultation
      </h2>
      <p class="font-body text-muted text-base max-w-lg mx-auto">
        Speak with Ansar Goraya, MARA Registered Migration Agent. No obligation. Confidential. Plain advice in plain English.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">

      <!-- Left: contact info -->
      <div class="reveal">
        <div class="glass-card-light rounded-sm p-8 mb-6">
          <h3 class="font-display font-medium text-royal-deep text-lg tracking-tight mb-6">Contact Information</h3>

          <dl class="space-y-5">
            <div class="flex items-start gap-4">
              <span class="text-xl flex-shrink-0 mt-0.5" aria-hidden="true">📍</span>
              <div>
                <dt class="font-body text-muted text-xs tracking-widest uppercase mb-1">Address</dt>
                <dd class="font-body text-ink text-sm">8 Tallis Circuit, Truganina VIC 3029</dd>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <span class="text-xl flex-shrink-0 mt-0.5" aria-hidden="true">📱</span>
              <div>
                <dt class="font-body text-muted text-xs tracking-widest uppercase mb-1">Mobile</dt>
                <dd>
                  <a href="tel:+61413769458" class="font-body text-royal-light hover:text-royal text-sm transition-colors">0413 769 458</a>
                  <span class="font-body text-muted text-xs ml-2">(+61 413 769 458)</span>
                </dd>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <span class="text-xl flex-shrink-0 mt-0.5" aria-hidden="true">📞</span>
              <div>
                <dt class="font-body text-muted text-xs tracking-widest uppercase mb-1">Landline</dt>
                <dd>
                  <a href="tel:+61370203358" class="font-body text-royal-light hover:text-royal text-sm transition-colors">03 7020 3358</a>
                </dd>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <span class="text-xl flex-shrink-0 mt-0.5" aria-hidden="true">✉️</span>
              <div>
                <dt class="font-body text-muted text-xs tracking-widest uppercase mb-1">Email</dt>
                <dd>
                  <a href="mailto:ansar@gemca.com.au" class="font-body text-royal-light hover:text-royal text-sm transition-colors">ansar@gemca.com.au</a>
                </dd>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <span class="text-xl flex-shrink-0 mt-0.5" aria-hidden="true">🕐</span>
              <div>
                <dt class="font-body text-muted text-xs tracking-widest uppercase mb-1">Business Hours</dt>
                <dd class="font-body text-ink text-sm">Mon–Fri · 9:00 AM – 5:30 PM AEST</dd>
              </div>
            </div>
          </dl>

          <!-- Primary CTA buttons -->
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a
              href="tel:+61413769458"
              class="flex-1 inline-flex items-center justify-center gap-2 bg-royal text-paper font-body text-sm font-medium px-5 py-3 rounded-sm tracking-wide transition-all duration-300 hover:bg-royal-light"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call 0413 769 458
            </a>
            <a
              href="https://wa.me/61413769458"
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 inline-flex items-center justify-center gap-2 border border-line hover:border-royal/30 text-ink hover:text-royal font-body text-sm font-medium px-5 py-3 rounded-sm tracking-wide transition-all duration-300"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp Us
            </a>
          </div>
        </div>

        <!-- Embedded Map placeholder -->
        <div class="rounded-sm overflow-hidden border border-line h-56 bg-mist flex items-center justify-center">
          <iframe
            title="GEMCA office location — 8 Tallis Circuit, Truganina VIC 3029"
            width="100%"
            height="100%"
            style="border:0"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3152.8!2d144.7408!3d-37.8427!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ad698b73b7b2ab5%3A0x1!2s8+Tallis+Circuit%2C+Truganina+VIC+3029!5e0!3m2!1sen!2sau!4v1234567890"
          ></iframe>
        </div>
      </div>

      <!-- Right: enquiry form -->
      <div class="reveal" style="transition-delay:0.15s">
        <div class="glass-card-light rounded-sm p-8">
          <h3 class="font-display font-medium text-royal-deep text-lg tracking-tight mb-6">Send an Enquiry</h3>

          <!--
            TODO: Replace action URL with your Formspree endpoint before launch.
            Sign up at formspree.io → create a form → copy the endpoint URL.
            Current fallback: mailto to ansar@gemca.com.au
          -->
          <div class="placeholder-todo mb-5 text-xs font-body inline-block">
            TODO: Replace form action with Formspree endpoint https://formspree.io/f/REPLACE_ME
          </div>

          <form
            action="mailto:ansar@gemca.com.au"
            method="POST"
            enctype="text/plain"
            class="space-y-5"
            novalidate
            aria-label="Enquiry form"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="first-name" class="block font-body text-xs text-muted tracking-widest uppercase mb-2">First Name *</label>
                <input
                  type="text"
                  id="first-name"
                  name="first_name"
                  required
                  autocomplete="given-name"
                  class="w-full bg-white border border-line rounded-sm px-4 py-3 font-body text-ink text-sm focus:outline-none focus:border-royal/40 focus:ring-1 focus:ring-royal/20 transition-colors"
                  placeholder="First name"
                />
              </div>
              <div>
                <label for="last-name" class="block font-body text-xs text-muted tracking-widest uppercase mb-2">Last Name *</label>
                <input
                  type="text"
                  id="last-name"
                  name="last_name"
                  required
                  autocomplete="family-name"
                  class="w-full bg-white border border-line rounded-sm px-4 py-3 font-body text-ink text-sm focus:outline-none focus:border-royal/40 focus:ring-1 focus:ring-royal/20 transition-colors"
                  placeholder="Last name"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block font-body text-xs text-muted tracking-widest uppercase mb-2">Email Address *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full bg-white border border-line rounded-sm px-4 py-3 font-body text-ink text-sm focus:outline-none focus:border-royal/40 focus:ring-1 focus:ring-royal/20 transition-colors"
                placeholder="your@email.com"
              />
            </div>

            <div>
              <label for="phone" class="block font-body text-xs text-muted tracking-widest uppercase mb-2">Phone Number</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                class="w-full bg-white border border-line rounded-sm px-4 py-3 font-body text-ink text-sm focus:outline-none focus:border-royal/40 focus:ring-1 focus:ring-royal/20 transition-colors"
                placeholder="+61 or 04XX..."
              />
            </div>

            <div>
              <label for="visa-type" class="block font-body text-xs text-muted tracking-widest uppercase mb-2">Visa Type of Interest</label>
              <select
                id="visa-type"
                name="visa_type"
                class="w-full bg-white border border-line rounded-sm px-4 py-3 font-body text-ink text-sm focus:outline-none focus:border-royal/40 focus:ring-1 focus:ring-royal/20 transition-colors appearance-none"
              >
                <option value="">Select a visa category...</option>
                <optgroup label="Skilled Migration">
                  <option>Skilled Independent (189)</option>
                  <option>Skilled Nominated (190)</option>
                  <option>Skilled Regional (491)</option>
                </optgroup>
                <optgroup label="Employer Sponsored">
                  <option>Temporary Skills Shortage (482)</option>
                  <option>Employer Nomination Scheme (186)</option>
                </optgroup>
                <optgroup label="Student &amp; Graduate">
                  <option>Student Visa (500)</option>
                  <option>Graduate Temporary (485)</option>
                  <option>Training Visa (407)</option>
                </optgroup>
                <optgroup label="Partner &amp; Family">
                  <option>Partner Visa — Onshore (820/801)</option>
                  <option>Partner Visa — Offshore (309/100)</option>
                  <option>Parent Visa</option>
                </optgroup>
                <optgroup label="Visitor &amp; Other">
                  <option>Visitor Visa (600)</option>
                  <option>Business Innovation &amp; Investment (188)</option>
                  <option>Visa Appeal / AAT</option>
                  <option>Other / Not sure</option>
                </optgroup>
              </select>
            </div>

            <div>
              <label for="occupation" class="block font-body text-xs text-muted tracking-widest uppercase mb-2">Occupation / Field</label>
              <input
                type="text"
                id="occupation"
                name="occupation"
                class="w-full bg-white border border-line rounded-sm px-4 py-3 font-body text-ink text-sm focus:outline-none focus:border-royal/40 focus:ring-1 focus:ring-royal/20 transition-colors"
                placeholder="e.g. Civil Engineer, Registered Nurse..."
              />
            </div>

            <div>
              <label for="message" class="block font-body text-xs text-muted tracking-widest uppercase mb-2">Message *</label>
              <textarea
                id="message"
                name="message"
                required
                rows="4"
                class="w-full bg-white border border-line rounded-sm px-4 py-3 font-body text-ink text-sm focus:outline-none focus:border-royal/40 focus:ring-1 focus:ring-royal/20 transition-colors resize-none"
                placeholder="Tell us briefly about your situation and what you're hoping to achieve..."
              ></textarea>
            </div>

            <!-- Consent -->
            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="consent"
                name="consent"
                required
                class="mt-1 flex-shrink-0 w-4 h-4 border border-line rounded accent-royal focus:ring-royal/20"
              />
              <label for="consent" class="font-body text-muted text-xs leading-relaxed">
                I consent to GEMCA collecting and handling my personal information to respond to this enquiry. I understand my information will be kept confidential in accordance with the Privacy Act 1988 and the MARA Code of Conduct.
              </label>
            </div>

            <button
              type="submit"
              class="btn-magnetic w-full bg-royal hover:bg-royal-light text-paper font-body text-sm font-medium py-3.5 rounded-sm tracking-wide transition-all duration-300 shadow-glass"
            >
              Send Enquiry
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
