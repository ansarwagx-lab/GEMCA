---
const articles = [
  {
    date: 'May 2025',
    tag: 'Skilled Migration',
    title: 'Understanding the SkillSelect Points Test: What Score Do You Actually Need in 2025?',
    desc: 'With invitation rounds becoming increasingly competitive, we break down the current score thresholds, how occupation ceilings work, and strategies to maximise your points before submitting an EOI.',
    readTime: '6 min read',
  },
  {
    date: 'April 2025',
    tag: 'Student Visas',
    title: 'The GTE Requirement: How to Write a Genuine Temporary Entrant Statement That Stands Up',
    desc: 'The Genuine Temporary Entrant criterion is one of the most misunderstood aspects of the Student Visa (Subclass 500). We explain what officers are actually assessing — and how to address it clearly.',
    readTime: '5 min read',
  },
  {
    date: 'March 2025',
    tag: 'Partner Visas',
    title: 'Evidence Checklist for the Partner Visa (820/801): What "Genuine Relationship" Really Means',
    desc: 'The Department assesses your relationship across four dimensions. This guide walks through what evidence to gather, how to present it, and the common mistakes that cause delays or refusals.',
    readTime: '7 min read',
  },
];
---

<section id="insights" class="py-24 lg:py-32 bg-paper" aria-labelledby="insights-heading">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Header -->
    <div class="reveal flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-14">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="gold-hairline-h w-10"></span>
          <span class="font-body text-gold text-xs tracking-[0.18em] uppercase">Insights</span>
        </div>
        <h2 id="insights-heading" class="font-display font-medium text-royal-deep text-3xl lg:text-4xl tracking-tight">
          Migration Guides &amp; Updates
        </h2>
      </div>
      <a href="/insights" class="flex-shrink-0 inline-flex items-center gap-2 border border-line text-muted hover:text-royal hover:border-royal font-body text-sm px-5 py-2.5 rounded-sm tracking-wide transition-all duration-200">
        All Articles
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>

    <!-- Article cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
      {articles.map((a, i) => (
        <article class="reveal glass-card-light sheen-card rounded-sm overflow-hidden group" style={`transition-delay:${i * 0.1}s`}>
          <!-- Placeholder image area -->
          <div class="h-44 bg-gradient-to-br from-royal/5 via-royal/10 to-royal/5 flex items-center justify-center relative overflow-hidden">
            <svg class="w-16 h-16 opacity-10 text-royal" aria-hidden="true"><use href="#mark-solid"/></svg>
            <!-- Tag -->
            <span class="absolute top-4 left-4 font-body text-[10px] tracking-[0.14em] uppercase text-royal bg-royal/10 px-2.5 py-1 rounded-sm">{a.tag}</span>
          </div>

          <!-- Content -->
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <span class="font-body text-muted text-xs">{a.date}</span>
              <span class="font-body text-muted text-xs">{a.readTime}</span>
            </div>
            <h3 class="font-display font-medium text-royal-deep text-base tracking-tight leading-snug mb-3 group-hover:text-royal-light transition-colors duration-200">
              {a.title}
            </h3>
            <p class="font-body text-muted text-xs leading-relaxed mb-4 line-clamp-3">{a.desc}</p>
            <span class="inline-flex items-center gap-1.5 text-royal-light font-body text-xs font-medium group-hover:gap-2.5 transition-all duration-200">
              Read article
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
