---
const categories = [
  {
    label: 'Student',
    visas: [
      { code: '500', name: 'Student Visa', desc: 'Higher education, TAFE, vocational, school and English language courses.' },
      { code: '485', name: 'Graduate Temporary', desc: 'Post-study work rights after completing an Australian degree.' },
      { code: '407', name: 'Training Visa', desc: 'Workplace-based occupational training for registered organisations.' },
    ],
  },
  {
    label: 'Skilled',
    visas: [
      { code: '189', name: 'Skilled Independent', desc: 'Points-tested permanent residence for skilled workers not sponsored.' },
      { code: '190', name: 'Skilled Nominated', desc: 'State or territory nomination adds 5 points to your SkillSelect score.' },
      { code: '491', name: 'Skilled Regional', desc: 'State or territory nomination, regional work requirement, pathway to 191.' },
      { code: '191', name: 'Permanent Residence (Skilled Regional)', desc: 'Permanent residence after 3 years on a 491 visa.' },
    ],
  },
  {
    label: 'Employer Sponsored',
    visas: [
      { code: '482', name: 'Temporary Skills Shortage', desc: 'Short-term, medium-term and labour agreement streams for sponsored workers.' },
      { code: '186', name: 'Employer Nomination Scheme', desc: 'Permanent employer sponsorship — direct entry and TRT streams.' },
      { code: '187', name: 'Regional Sponsored Migration', desc: 'Employer sponsorship in regional Australia.' },
    ],
  },
  {
    label: 'Family & Partner',
    visas: [
      { code: '820/801', name: 'Partner (Onshore)', desc: 'Temporary then permanent partner visa for applicants in Australia.' },
      { code: '309/100', name: 'Partner (Offshore)', desc: 'Offshore partner visa for applicants outside Australia.' },
      { code: '600', name: 'Visitor — Family Stream', desc: 'Family visit for relatives of Australian residents or citizens.' },
      { code: '103/143/864', name: 'Parent Visas', desc: 'Various parent visa streams including contributory options.' },
    ],
  },
  {
    label: 'Business & Investor',
    visas: [
      { code: '188', name: 'Business Innovation & Investment', desc: 'Provisional visa for business owners, investors and entrepreneurs.' },
      { code: '888', name: 'Permanent Business Innovation', desc: 'Permanent residence after holding a 188 visa.' },
      { code: '132', name: 'Business Talent', desc: 'Permanent visa for high-calibre business owners and venture capital.' },
    ],
  },
  {
    label: 'Visitor',
    visas: [
      { code: '600', name: 'Visitor Visa', desc: 'Tourist, family visit, and business visitor streams — stay up to 12 months.' },
      { code: 'ETA', name: 'Electronic Travel Authority', desc: 'Passport-linked electronic visa for eligible passport holders.' },
      { code: 'eVisitor', name: 'eVisitor', desc: 'Free online visa for eligible European passport holders.' },
    ],
  },
];
---

<section id="visas" class="py-24 lg:py-32 bg-paper" aria-labelledby="visas-heading" style="background: linear-gradient(180deg, #fff 0%, #F5F6F9 100%)"  >
  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Section header -->
    <div class="reveal text-center mb-14">
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="gold-hairline-h w-10"></span>
        <span class="font-body text-gold text-xs tracking-[0.18em] uppercase">Visa Categories</span>
        <span class="gold-hairline-h w-10"></span>
      </div>
      <h2 id="visas-heading" class="font-display font-medium text-royal-deep text-3xl lg:text-5xl tracking-tight mb-4">
        Find Your Pathway
      </h2>
      <p class="font-body text-muted text-base max-w-lg mx-auto">
        Australia's visa system is complex. We know every stream and subclass — and how to find the one that fits your circumstances.
      </p>
    </div>

    <!-- Category tabs -->
    <div class="reveal" role="tablist" aria-label="Visa categories">
      <div class="flex flex-wrap gap-2 mb-10 justify-center">
        {categories.map((cat, i) => (
          <button
            class="visa-tab font-body text-sm px-5 py-2 rounded-sm border transition-all duration-200"
            data-tab={i}
            role="tab"
            aria-selected={i === 0}
            aria-controls={`tab-panel-${i}`}
            id={`tab-${i}`}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Panels -->
      {categories.map((cat, i) => (
        <div
          id={`tab-panel-${i}`}
          role="tabpanel"
          aria-labelledby={`tab-${i}`}
          class={`visa-panel grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 ${i !== 0 ? 'hidden' : ''}`}
        >
          {cat.visas.map(v => (
            <div class="glass-card-light rounded-sm p-5 group sheen-card">
              <div class="flex items-start justify-between mb-3">
                <span class="inline-block font-display font-medium text-royal text-lg tracking-tight">{v.code}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-gold mt-2 flex-shrink-0"></span>
              </div>
              <h3 class="font-body text-ink text-sm font-medium mb-2">{v.name}</h3>
              <p class="font-body text-muted text-xs leading-relaxed">{v.desc}</p>
            </div>
          ))}
        </div>
      ))}
    </div>

    <!-- Skills assessment note -->
    <div id="skills-assessment" class="reveal mt-16 glass-card-light rounded-sm p-8 lg:p-10 flex flex-col lg:flex-row items-start lg:items-center gap-6">
      <div class="w-12 h-12 rounded-sm bg-royal/8 flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6 text-royal" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
        </svg>
      </div>
      <div class="flex-1">
        <h3 class="font-display font-medium text-royal-deep text-xl tracking-tight mb-2">Skills Assessment Support</h3>
        <p class="font-body text-muted text-sm leading-relaxed">
          Many skilled and employer-sponsored visas require an Australian skills assessment. We help you identify the correct assessing authority (Engineers Australia, VETASSESS, AIM, TRA, ACWA and others), prepare your application, and handle supporting documentation.
        </p>
      </div>
      <a
        href="#contact"
        class="flex-shrink-0 inline-flex items-center gap-2 border border-royal/30 text-royal hover:bg-royal hover:text-paper font-body text-sm font-medium px-5 py-2.5 rounded-sm tracking-wide transition-all duration-300"
      >
        Get Assessment Help
      </a>
    </div>
  </div>
</section>

<style>
  .visa-tab {
    color: var(--muted);
    border-color: var(--line);
    background: transparent;
  }
  .visa-tab:hover,
  .visa-tab[aria-selected="true"] {
    background: var(--royal);
    color: var(--paper);
    border-color: var(--royal);
  }
</style>

<script>
  const tabs = document.querySelectorAll('.visa-tab');
  const panels = document.querySelectorAll('.visa-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const idx = parseInt(tab.getAttribute('data-tab') || '0');
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === idx)));
      panels.forEach((p, i) => p.classList.toggle('hidden', i !== idx));
    });
  });
</script>
