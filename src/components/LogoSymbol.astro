---
// Reusable SVG symbol definitions — include once per page, use with <use href="#mark-glass">
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <linearGradient id="blueGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%"  stop-color="#3A66D6"/>
      <stop offset="46%" stop-color="#12409A"/>
      <stop offset="100%" stop-color="#05143a"/>
    </linearGradient>
    <linearGradient id="goldGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#F0DCAC"/>
      <stop offset="48%" stop-color="#C7A663"/>
      <stop offset="100%" stop-color="#9A742F"/>
    </linearGradient>
    <linearGradient id="sheen" x1="0" y1="0" x2="0.9" y2="1">
      <stop offset="0%"  stop-color="#ffffff" stop-opacity=".62"/>
      <stop offset="34%" stop-color="#ffffff" stop-opacity=".10"/>
      <stop offset="62%" stop-color="#ffffff" stop-opacity="0"/>
    </linearGradient>
    <filter id="softShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="3.2" stdDeviation="3.4" flood-color="#0a1c47" flood-opacity="0.32"/>
    </filter>
    <symbol id="mark-glass" viewBox="0 0 120 120">
      <g filter="url(#softShadow)">
        <path d="M104.50 42.02 A48 48 0 1 0 104.50 77.98 L87.82 71.24 A30 30 0 1 1 87.82 48.76 Z" fill="url(#blueGrad)" stroke="#e2e7ef" stroke-width="0.5"/>
        <rect x="62" y="51" width="42.5" height="18" rx="1" fill="url(#blueGrad)" stroke="#e2e7ef" stroke-width="0.5"/>
        <path d="M104.50 42.02 A48 48 0 1 0 104.50 77.98 L87.82 71.24 A30 30 0 1 1 87.82 48.76 Z" fill="url(#sheen)"/>
        <rect x="62" y="51" width="42.5" height="18" rx="1" fill="url(#sheen)"/>
        <rect x="62" y="57" width="6" height="6" rx="0.6" fill="url(#goldGrad)"/>
      </g>
    </symbol>
    <symbol id="mark-solid" viewBox="0 0 120 120">
      <path d="M104.50 42.02 A48 48 0 1 0 104.50 77.98 L87.82 71.24 A30 30 0 1 1 87.82 48.76 Z" fill="currentColor"/>
      <rect x="62" y="51" width="42.5" height="18" rx="1" fill="currentColor"/>
    </symbol>
  </defs>
</svg>
