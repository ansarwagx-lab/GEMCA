---
const steps = [
  {
    num: '01',
    title: 'Assess',
    desc: 'We review your profile, goals, and eligibility across all applicable visa streams. No jargon — a clear picture of your options.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>`,
  },
  {
    num: '02',
    title: 'Strategise',
    desc: 'We build your tailored migration strategy — timing, documents, sponsorship considerations, and any pre-application preparation required.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>`,
  },
  {
    num: '03',
    title: 'Lodge',
    desc: 'We compile, review, and lodge your complete application on ImmiAccount. Every document checked, every form verified before submission.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>`,
  },
  {
    num: '04',
    title: 'Outcome',
    desc: 'We monitor your case, respond to requests from the Department, and keep you informed at every stage through to a decision.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>`,
  },
];
---

<section id="pathway" class="py-24 lg:py-32 bg-royal-deep relative overflow-hidden" aria-labelledby="pathway-heading">
  <!-- Background grid -->
  <div class="absolute inset-0 opacity-[0.035]" aria-hidden="true" style="background-image: linear-gradient(rgba(201,208,219,1) 1px, transparent 1px), linear-gradient(90deg, rgba(201,208,219,1) 1px, transparent 1px); background-size: 40px 40px;"></div>
  <!-- Gradient overlay -->
  <div class="absolute inset-0" aria-hidden="true" style="background: radial-gradient(ellipse at 15% 60%, rgba(46,91,199,0.2) 0, transparent 55%), radial-gradient(ellipse at 85% 30%, rgba(5,20,58,0.5) 0, transparent 55%)"></div>

  <!-- Crystal decoration -->
  <div class="absolute right-0 bottom-0 opacity-[0.06] pointer-events-none" aria-hidden="true">
    <svg class="w-96 h-96" aria-hidden="true"><use href="#mark-glass"/></svg>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Section header -->
    <div class="reveal text-center mb-20">
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="gold-hairline-h w-10"></span>
        <span class="font-body text-gold text-xs tracking-[0.18em] uppercase">The Threshold Process</span>
        <span class="gold-hairline-h w-10"></span>
      </div>
      <h2 id="pathway-heading" class="font-display font-medium text-paper text-3xl lg:text-5xl tracking-tight mb-4">
        Your Pathway to Australia
      </h2>
      <p class="font-body text-platinum/70 text-base max-w-lg mx-auto">
        The Meridian mark represents a threshold — a defined point you pass through. This is how we get you there.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative">
      <!-- Gold connector line (desktop) -->
      <div class="hidden lg:block absolute top-12 left-0 right-0 h-px" aria-hidden="true">
        <svg class="w-full h-px" preserveAspectRatio="none" viewBox="0 0 1000 1" fill="none">
          <line id="pathway-line" x1="12.5%" y1="0.5" x2="87.5%" y2="0.5" stroke="#C7A663" stroke-width="1" stroke-dasharray="4 6" opacity="0.5"/>
        </svg>
      </div>

      <!-- Steps grid -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 lg:gap-5">
        {steps.map((step, i) => (
          <div class="reveal pathway-step flex flex-col items-center lg:items-start text-center lg:text-left" style={`transition-delay:${i * 0.12}s`}>
            <!-- Node -->
            <div class="relative mb-6">
              <div class="w-24 h-24 rounded-full glass-card flex items-center justify-center group transition-all duration-300 hover:shadow-glass-lg">
                <svg class="w-8 h-8 text-platinum" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={step.icon}/>
              </div>
              <!-- Step number -->
              <span class="absolute -top-2 -right-2 w-7 h-7 rounded-full bg-royal-light border border-royal-light/40 flex items-center justify-center font-display font-medium text-paper text-[10px] tracking-wider">
                {step.num}
              </span>
              {/* Gold node on last step */}
              {i === 3 && (
                <span class="absolute -bottom-1 -right-1 w-3 h-3 rounded-full" style="background: linear-gradient(135deg, #F0DCAC, #C7A663); box-shadow: 0 0 8px rgba(199,166,99,0.6);"></span>
              )}
            </div>

            <h3 class="font-display font-medium text-paper text-xl tracking-tight mb-3">{step.title}</h3>
            <p class="font-body text-platinum/65 text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom CTA -->
    <div class="reveal text-center mt-16">
      <a
        href="#contact"
        class="btn-magnetic inline-flex items-center gap-2 bg-paper/10 hover:bg-paper/15 border border-paper/15 hover:border-gold/30 text-paper font-body text-sm font-medium px-7 py-3 rounded-sm tracking-wide transition-all duration-300 backdrop-blur-sm"
      >
        Start Your Assessment
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</section>

<script>
  const pathwayLine = document.getElementById('pathway-line');
  if (pathwayLine && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) pathwayLine.classList.add('drawn');
      });
    }, { threshold: 0.5 });
    observer.observe(pathwayLine);
  }
</script>
