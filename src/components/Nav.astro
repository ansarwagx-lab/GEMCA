---
---
<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 px-6 lg:px-10" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto flex items-center justify-between h-18 lg:h-24">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group" aria-label="GEMCA — Home">
      <svg class="w-11 h-11 lg:w-14 lg:h-14 transition-transform group-hover:scale-105 duration-300 flex-shrink-0" aria-hidden="true">
        <use href="#mark-glass"/>
      </svg>
      <div class="flex flex-col">
        <span class="font-display font-medium text-paper tracking-widest2 text-base lg:text-xl leading-none">GEMCA</span>
        <span class="font-body text-platinum/70 text-[9px] lg:text-[10px] tracking-[0.12em] leading-none mt-1 hidden sm:block">EDUCATION &amp; MIGRATION · AUSTRALIA</span>
      </div>
    </a>

    <!-- Desktop nav links -->
    <div class="hidden lg:flex items-center gap-8">
      <a href="#services" class="nav-link font-body text-platinum-dp text-sm tracking-wide hover:text-paper transition-colors duration-200">Services</a>
      <a href="#visas" class="nav-link font-body text-platinum-dp text-sm tracking-wide hover:text-paper transition-colors duration-200">Visas</a>
      <a href="#skills-assessment" class="nav-link font-body text-platinum-dp text-sm tracking-wide hover:text-paper transition-colors duration-200">Skills Assessment</a>
      <a href="#about" class="nav-link font-body text-platinum-dp text-sm tracking-wide hover:text-paper transition-colors duration-200">About</a>
      <a href="#insights" class="nav-link font-body text-platinum-dp text-sm tracking-wide hover:text-paper transition-colors duration-200">Insights</a>
    </div>

    <!-- CTA -->
    <div class="hidden lg:block">
      <a href="#contact" class="btn-magnetic inline-flex items-center gap-2 bg-royal-light hover:bg-royal border border-royal-light/40 hover:border-gold/30 text-paper font-body text-sm font-medium px-5 py-2.5 rounded-sm tracking-wide transition-all duration-300 shadow-glass">
        Book Consultation
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden flex flex-col gap-1.5 p-2 -mr-2 group"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="w-6 h-px bg-paper transition-all duration-300 group-aria-expanded:rotate-45 group-aria-expanded:translate-y-2"></span>
      <span class="w-6 h-px bg-paper transition-all duration-300 group-aria-expanded:opacity-0"></span>
      <span class="w-6 h-px bg-paper transition-all duration-300 group-aria-expanded:-rotate-45 group-aria-expanded:-translate-y-2"></span>
    </button>
  </div>
</nav>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="fixed inset-y-0 right-0 w-4/5 max-w-xs z-40 glass-card lg:hidden pt-20 pb-10 px-8 flex flex-col gap-6"
  aria-hidden="true"
  role="dialog"
  aria-label="Mobile navigation"
>
  <nav class="flex flex-col gap-5 mt-4">
    <a href="#services" class="mobile-nav-link font-body text-platinum text-base tracking-wide hover:text-paper py-1 border-b border-platinum/10 transition-colors">Services</a>
    <a href="#visas" class="mobile-nav-link font-body text-platinum text-base tracking-wide hover:text-paper py-1 border-b border-platinum/10 transition-colors">Visas</a>
    <a href="#skills-assessment" class="mobile-nav-link font-body text-platinum text-base tracking-wide hover:text-paper py-1 border-b border-platinum/10 transition-colors">Skills Assessment</a>
    <a href="#about" class="mobile-nav-link font-body text-platinum text-base tracking-wide hover:text-paper py-1 border-b border-platinum/10 transition-colors">About</a>
    <a href="#insights" class="mobile-nav-link font-body text-platinum text-base tracking-wide hover:text-paper py-1 border-b border-platinum/10 transition-colors">Insights</a>
  </nav>
  <a href="#contact" class="mt-4 inline-flex justify-center items-center gap-2 bg-royal-light text-paper font-body text-sm font-medium px-5 py-3 rounded-sm tracking-wide">
    Book Consultation
  </a>
  <div class="mt-auto text-muted text-xs font-body">
    <p>📍 Truganina VIC 3029</p>
    <p class="mt-1">📱 0413 769 458</p>
    <p class="mt-1">Mon–Fri · 9 AM – 5:30 PM AEST</p>
  </div>
</div>

<!-- Overlay -->
<div id="mobile-overlay" class="fixed inset-0 z-30 bg-royal-deep/60 backdrop-blur-sm hidden lg:hidden" aria-hidden="true"></div>

<style>
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--gold);
    transition: width 0.3s ease;
  }
  .nav-link:hover::after {
    width: 100%;
  }
</style>

<script>
  const nav = document.getElementById('main-nav');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');

  // Scroll effect
  const onScroll = () => {
    if (window.scrollY > 60) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu toggle
  const toggleMenu = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('open', open);
    menu?.setAttribute('aria-hidden', String(!open));
    overlay?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  btn?.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    toggleMenu(!isOpen);
  });

  overlay?.addEventListener('click', () => toggleMenu(false));

  // Close on link click
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => toggleMenu(false));
  });
</script>
